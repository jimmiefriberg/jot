{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jot",
  "version": "0.1.7",
  "identifier": "com.jimmiefriberg.jot",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; frame-src asset: http://asset.localhost; connect-src ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "text",
          "log"
        ],
        "name": "Plain Text",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "md",
          "markdown",
          "mdown"
        ],
        "name": "Markdown",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "json",
          "jsonc",
          "json5"
        ],
        "name": "JSON",
        "role": "Editor",
        "mimeType": "application/json"
      },
      {
        "ext": [
          "jsonl",
          "ndjson"
        ],
        "name": "JSON Lines",
        "role": "Editor",
        "mimeType": "application/jsonl"
      },
      {
        "ext": [
          "html",
          "htm"
        ],
        "name": "HTML",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/html"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/pdf"
      },
      {
        "ext": [
          "csv",
          "tsv"
        ],
        "name": "CSV",
        "role": "Editor",
        "mimeType": "text/csv"
      },
      {
        "ext": [
          "yml",
          "yaml"
        ],
        "name": "YAML",
        "role": "Editor",
        "mimeType": "application/yaml"
      },
      {
        "ext": [],
        "contentTypes": [
          "public.folder"
        ],
        "name": "Folder",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "xml",
          "plist",
          "svg",
          "xsd",
          "xsl",
          "xslt"
        ],
        "name": "XML",
        "role": "Editor",
        "mimeType": "application/xml"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDMzJDRTEzNkJCOUI4QjUKUldTMXVMbHJFODR5WEs3aTd3WWtxVjcvZFFFQ1kzN0djQ3VoU1U1eWE5K2RrOG9PdXlTYnorSXYK",
      "endpoints": [
        "https://github.com/jimmiefriberg/jot/releases/latest/download/latest.json"
      ]
    }
  }
}
